# Neon Auth & Database Configuration
VITE_NEON_AUTH_URL=https://auth.neon.tech/v1/projects/your-neon-project-id
VITE_NEON_DATA_API_URL=https://data.neon.tech/v1/projects/your-neon-project-id

# Gemini / Google AI Services Key (opcional caso utilize IA no sistema)
GOOGLE_API_KEY=sua_chave_api_aqui
